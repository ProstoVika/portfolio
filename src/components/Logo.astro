---
/**
 * Line-drawn "V" logo. On hover / keyboard focus a pen redraws the V:
 * the stroke runs off one end and is drawn again from the start.
 * pathLength="1" lets the dash values be 0..1 whatever the real length is.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<a class="logo" href="/" aria-label={label}>
  <svg class="logo__mark" viewBox="0 0 48 40" aria-hidden="true" focusable="false">
    <path d="M4 4 L24 34 L44 4" pathLength="1" />
  </svg>
</a>

<style>
  .logo {
    display: block;
    inline-size: 2.5rem;
    color: inherit;
  }

  .logo__mark {
    inline-size: 100%;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .logo__mark path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo:hover path,
    .logo:focus-visible path {
      animation: redraw 0.9s var(--ease-in-out);
    }
  }

  /* 0 → -1: the line runs off the end; jump to 1 (hidden at the start); 1 → 0: drawn again */
  @keyframes redraw {
    49% {
      stroke-dashoffset: -1;
    }
    50% {
      stroke-dashoffset: 1;
    }
  }
</style>
