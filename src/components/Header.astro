---
/**
 * Site header: logo on the left, burger on the right.
 *
 * The menu is built on two native features, no framework:
 *  - Popover API: top layer, Esc / click-outside to close, aria-expanded on the toggle;
 *    its ::backdrop blurs the page behind the menu.
 *  - <details name="…">: an exclusive accordion — opening one group closes the others.
 */
import Logo from '@/components/Logo.astro';
import { getCollection } from 'astro:content';
import { site, socials } from '@/data/site';

const projects = (
  await getCollection('projects', ({ data }) => !data.draft && data.type !== 'training')
).sort(
  (a, b) => a.data.order - b.data.order,
);

interface MenuLink {
  label: string;
  href: string;
  external?: boolean;
}

const groups: { title: string; links: MenuLink[] }[] = [
  {
    title: 'Work',
    links: [
      { label: 'All work', href: '/#work' },
      ...projects.map((p) => ({ label: p.data.title, href: `/work/${p.id}` })),
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'Story', href: '/#story' },
      { label: 'How I work', href: '/#approach' },
      { label: 'Toolkit', href: '/#toolkit' },
      { label: 'CV (PDF)', href: site.cv, external: true },
    ],
  },
  {
    title: 'Lab',
    links: [
      { label: 'Training projects', href: '/lab' },
      { label: '2024 portfolio', href: site.oldPortfolio, external: true },
    ],
  },
];

const phoneHref = `tel:${site.phone.replace(/\s/g, '')}`;
---

<header class="site-header">
  <Logo label={`${site.name}, home`} />

  <nav class="quick-nav label" aria-label="Quick">
    <a class="link-line" href="/#work">Work</a>
    <span aria-hidden="true">/</span>
    <a class="link-line" href="/lab">Lab</a>
  </nav>

  <button class="burger" type="button" popovertarget="site-menu" aria-label="Open menu">
    <span class="burger__lines" aria-hidden="true"></span>
  </button>
</header>

<div class="menu" id="site-menu" popover>
  <div class="menu__top">
    <Logo label={`${site.name}, home`} />
    <button
      class="menu__close"
      type="button"
      popovertarget="site-menu"
      popovertargetaction="hide"
      aria-label="Close menu"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M2 2 L22 22 M22 2 L2 22" />
      </svg>
    </button>
  </div>

  <div class="menu__body">
    <nav class="menu__nav" aria-label="Main">
      {
        groups.map(({ title, links }, i) => (
          <details class="menu__group" name="menu-group" open={i === 0}>
            <summary class="menu__summary">
              <span class="menu__number">({i + 1})</span>
              <span class="menu__title">{title}</span>
              <span class="menu__toggle" aria-hidden="true" />
            </summary>

            <ol class="menu__sublist" role="list">
              {links.map(({ label, href, external }, j) => (
                <li>
                  <a
                    class="menu__link"
                    href={href}
                    {...(external && { target: '_blank', rel: 'noopener' })}
                  >
                    <span class="menu__link-number">
                      {i + 1}.{j + 1}
                    </span>
                    <span class="menu__link-text">{label}</span>
                    <svg class="menu__arrow" viewBox="0 0 32 8" aria-hidden="true" focusable="false">
                      <path d="M0 4 H31 M27 1 L31 4 L27 7" />
                    </svg>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        ))
      }
    </nav>

    <aside class="menu__contacts" aria-label="Contacts">
      <dl>
        <div>
          <dt>E:</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        {
          site.phone && (
            <div>
              <dt>T:</dt>
              <dd>
                <a href={phoneHref}>{site.phone.replace(/ /g, '\u00A0')}</a> ({site.location})
              </dd>
            </div>
          )
        }
        <div>
          <dt>S.M:</dt>
          <dd>
            {
              socials.map(({ label, href }, i) => (
                <>
                  <a href={href} rel="me noopener" target="_blank">{label}</a>{i < socials.length - 1 && ', '}
                </>
              ))
            }
          </dd>
        </div>
      </dl>

      <a class="menu__cta" href="/#contact">
        <span>Contact me</span>
        <svg class="menu__arrow" viewBox="0 0 32 8" aria-hidden="true" focusable="false">
          <path d="M0 4 H31 M27 1 L31 4 L27 7" />
        </svg>
      </a>
    </aside>
  </div>
</div>

<script>
  // Close the menu after choosing a link (anchor links don't reload the page).
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.hidePopover();
  });
</script>

<style>
  .site-header,
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-s) var(--gutter);
  }

  /* Logo · centred quick links · burger */
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
  }

  .site-header > :global(:last-child) {
    justify-self: end;
  }

  .quick-nav {
    display: flex;
    gap: 0.5em;
  }

  .quick-nav a {
    color: inherit;
  }

  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    color: #fff;
    mix-blend-mode: difference; /* readable over both the paper and the dark hero */
    pointer-events: none; /* clicks pass through the empty middle… */
  }

  /* :global because the logo is another component with its own scope */
  .site-header > :global(*) {
    pointer-events: auto; /* …but the logo and burger stay clickable */
  }

  /* ── Burger: two thin lines, the lower one shorter; they even out on hover ── */
  .burger {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .burger__lines,
  .burger__lines::before {
    display: block;
    inline-size: 1.75rem;
    block-size: var(--hairline);
    background: currentColor;
    translate: 0 -4px;
    transition: inline-size var(--duration) var(--ease-out);
  }

  .burger__lines::before {
    content: '';
    inline-size: 1.25rem;
    margin-inline-start: auto;
    translate: 0 8px;
  }

  .burger:hover .burger__lines::before {
    inline-size: 1.75rem;
  }

  /* ── Menu: transparent sheet over a blurred, darkened page ── */
  .menu {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow-y: auto;
    background: transparent;
    color: var(--menu-ink);
    font-family: var(--font-text);
    text-transform: uppercase;

    opacity: 0;
    transition:
      opacity var(--duration) var(--ease-out),
      display var(--duration) allow-discrete,
      overlay var(--duration) allow-discrete;
  }

  .menu::backdrop {
    background: var(--menu-veil);
    backdrop-filter: blur(24px) saturate(0.8);
    opacity: 0;
    transition:
      opacity var(--duration) var(--ease-out),
      display var(--duration) allow-discrete,
      overlay var(--duration) allow-discrete;
  }

  .menu:popover-open,
  .menu:popover-open::backdrop {
    opacity: 1;
  }

  @starting-style {
    .menu:popover-open,
    .menu:popover-open::backdrop {
      opacity: 0;
    }
  }

  .menu :global(.logo) {
    color: var(--menu-ink);
  }

  .menu a {
    color: inherit;
  }

  .menu__close {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    aspect-ratio: 1;
    padding: 0.75rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .menu__close svg,
  .menu__arrow {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .menu__close svg {
    inline-size: 100%;
    transition: rotate var(--duration) var(--ease-out);
  }

  .menu__close:hover svg {
    rotate: 90deg;
  }

  .menu__body {
    display: grid;
    gap: var(--space-xl);
    align-content: center;
    padding: var(--space-l) var(--gutter) var(--space-xl);
  }

  @media (width >= 64rem) {
    .menu__body {
      grid-template-columns: minmax(0, 38rem) minmax(0, 20rem);
      justify-content: space-between;
      align-items: start;
    }
  }

  /* ── Accordion groups ── */
  .menu__group {
    box-shadow: var(--menu-engrave);
  }

  .menu {
    --indent: clamp(3.5rem, 1rem + 8vw, 7rem);
  }

  .menu__summary {
    display: grid;
    grid-template-columns: var(--indent) 1fr auto;
    align-items: baseline;
    padding-block: var(--space-m) var(--space-s);
    cursor: pointer;
    list-style: none;
  }

  .menu__summary::-webkit-details-marker {
    display: none;
  }

  .menu__number,
  .menu__link-number {
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  .menu__title {
    font-size: var(--step-2);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  /* Plus that turns into a minus */
  .menu__toggle {
    position: relative;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    align-self: center;
  }

  .menu__toggle::before,
  .menu__toggle::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    block-size: var(--hairline);
    background: currentColor;
    transition: rotate var(--duration) var(--ease-out);
  }

  .menu__toggle::after {
    rotate: 90deg;
  }

  .menu__group[open] .menu__toggle::after {
    rotate: 0deg;
  }

  .menu__sublist {
    margin-inline-start: var(--indent);
    padding-block-end: var(--space-m);
    box-shadow: 0 -1px 0 rgb(255 255 255 / 0.5);
  }

  .menu__sublist li {
    box-shadow: var(--menu-engrave);
  }

  .menu__sublist li:last-child {
    box-shadow: none;
  }

  .menu__link {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: center;
    padding-block: var(--space-xs);
    font-size: var(--step--1);
    font-weight: 400;
    text-decoration: none;
  }

  /* Arrow slides in on hover */
  .menu__link .menu__arrow {
    inline-size: 2rem;
    opacity: 0;
    translate: -0.75rem 0;
    transition:
      opacity var(--duration-fast) ease,
      translate var(--duration) var(--ease-out);
  }

  .menu__link:hover .menu__arrow,
  .menu__link:focus-visible .menu__arrow {
    opacity: 1;
    translate: 0;
  }

  .menu__link:hover .menu__link-text {
    translate: 0.35rem 0;
  }

  .menu__link-text {
    transition: translate var(--duration) var(--ease-out);
  }

  /* ── Contacts column ── */
  .menu__contacts {
    display: grid;
    gap: var(--space-xl);
    font-size: var(--step--1);
  }

  .menu__contacts dl {
    display: grid;
    gap: var(--space-l);
  }

  .menu__contacts dt {
    margin-block-end: var(--space-xs);
  }

  .menu__contacts dd {
    line-height: 1.9;
  }

  .menu__contacts dd a {
    text-decoration-thickness: var(--hairline);
    text-underline-offset: 0.3em;
  }

  .menu__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-inline-size: 16rem;
    padding-block-end: var(--space-s);
    border-block-end: var(--hairline) solid currentColor;
    text-decoration: none;
  }

  .menu__cta .menu__arrow {
    inline-size: 2.5rem;
    transition: translate var(--duration) var(--ease-out);
  }

  .menu__cta:hover .menu__arrow {
    translate: 0.5rem 0;
  }

  .menu :focus-visible {
    outline-color: var(--menu-ink);
  }
</style>
