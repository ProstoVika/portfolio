---
/** Site footer: socials, CV, source code, copyright. */
import { site, socials } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <ul class="site-footer__links" role="list">
    {
      socials.map(({ label, href }) => (
        <li>
          <a href={href} rel="me noopener" target="_blank">
            {label}
          </a>
        </li>
      ))
    }
    <li><a href={site.cv} target="_blank" rel="noopener">CV (PDF)</a></li>
  </ul>

  <p class="site-footer__meta">
    © {year} {site.name}. Built with Astro &amp; React. <a href={site.source} rel="noopener" target="_blank">Source on GitHub</a>.
  </p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    margin-block-start: var(--space-2xl);
    padding: var(--space-l) var(--gutter);
    border-block-start: var(--hairline) solid var(--line);
    font-size: var(--step--1);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }

  .site-footer__meta {
    color: var(--ink-muted);
  }
</style>
