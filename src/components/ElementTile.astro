---
/**
 * Periodic-table tile — the core visual of Vanadium.
 * Used for the logo (23 · V · Vanadium) and for every project card.
 * Screen readers hear one clean label instead of four separate fragments.
 */
interface Props {
  number: number;
  symbol: string;
  name: string;
  caption?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { number, symbol, name, caption, size = 'md' } = Astro.props;
---

<span class:list={['tile', `tile--${size}`]} role="img" aria-label={`${name}, ${number}`}>
  <span class="tile__number" aria-hidden="true">{number}</span>
  <span class="tile__symbol" aria-hidden="true">{symbol}</span>
  <span class="tile__name" aria-hidden="true">{name}</span>
  {caption && <span class="tile__caption" aria-hidden="true">{caption}</span>}
</span>

<style>
  .tile {
    --tile-size: 7rem;
    position: relative;
    display: inline-grid;
    grid-template-rows: auto 1fr auto;
    inline-size: var(--tile-size);
    aspect-ratio: 1;
    padding: calc(var(--tile-size) * 0.08);
    border: var(--hairline) solid var(--line);
    background: var(--paper-raised);
    color: var(--ink);
    line-height: 1;
    transition:
      background var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out);
  }

  .tile--sm { --tile-size: 2.75rem; }
  .tile--lg { --tile-size: clamp(7rem, 5rem + 8vw, 11rem); }

  .tile__number,
  .tile__caption {
    font-family: var(--font-mono);
    font-size: calc(var(--tile-size) * 0.11);
  }

  .tile__symbol {
    place-self: center;
    font-family: var(--font-display);
    font-size: calc(var(--tile-size) * 0.48);
  }

  .tile__name {
    justify-self: center;
    max-inline-size: 100%;
    overflow: hidden;
    font-size: calc(var(--tile-size) * 0.1);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tile__caption {
    position: absolute;
    inset-block-start: calc(var(--tile-size) * 0.08);
    inset-inline-end: calc(var(--tile-size) * 0.08);
    color: var(--ink-muted);
  }

  /* The small logo tile only shows number + symbol */
  .tile--sm .tile__name,
  .tile--sm .tile__caption { display: none; }
  .tile--sm .tile__number { font-size: 0.55rem; }
</style>
