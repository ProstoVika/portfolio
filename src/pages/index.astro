---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { Image } from 'astro:assets';
import { heroCode } from '@/data/hero-code';
import { about, site, socials } from '@/data/site';
import portrait from '@/assets/portrait.jpg';
import { gallery, MIN_GALLERY } from '@/data/gallery';

---

<BaseLayout>
  <!-- ───────────── Hero ───────────── -->
  <section class="hero" aria-labelledby="hero-title">
    <canvas class="code-field" aria-hidden="true"></canvas>

    <h1 class="visually-hidden" id="hero-title">{site.name}, {site.role.toLowerCase()} in {site.location}</h1>

    <!-- The "about me" as code. Each visible character is its own span so it can fly in from the field. -->
    <div class="hero__code" aria-hidden="true">
      {
        heroCode.map((line) => (
          <span class="hero__line">
            {line.map(([kind, text]) =>
              kind === 'space' ? (
                text
              ) : (
                <span class={`tok tok--${kind}`}>
                  {[...text].map((char) => (char === ' ' ? ' ' : <span data-char>{char}</span>))}
                </span>
              ),
            )}
          </span>
        ))
      }
    </div>

    <a class="hero__scroll label" href={gallery.length >= MIN_GALLERY ? '#work' : '#about'}>
      <svg class="hero__arrow" viewBox="0 0 12 40" aria-hidden="true" focusable="false">
        <path d="M6 0 V38 M1 33 L6 38 L11 33" />
      </svg>
      <span class="link-line">Scroll down</span>
    </a>
  </section>

  <!-- ───────────── Gallery: endless strip of project screenshots (drag, swipe or arrow keys) ───────────── -->
  {
    gallery.length >= MIN_GALLERY && (
    <section class="gallery" id="work" aria-label="Client websites. Drag or use the arrow keys" tabindex="0">
      <div class="gallery__track">
        {
          [false, true].map((isCopy) => (
            <ul class="gallery__list" role="list" aria-hidden={isCopy ? 'true' : undefined} inert={isCopy}>
              {gallery.map(({ image, alt, href, external }) => (
                <li class="gallery__item">
                  <a href={href} draggable="false" {...(external && { target: '_blank', rel: 'noopener' })}>
                    <Image
                      src={image}
                      alt={isCopy ? '' : alt}
                      widths={[640, 1000, 1400, 1900]}
                      sizes="(min-width: 64rem) 50vw, 90vw"
                      draggable="false"
                    />
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
      <p class="gallery__note label">
        Client websites I built or rebuilt. More work is under NDA and happy to discuss.
        Training projects live in the <a class="link-line" href="/lab">Lab</a>.
      </p>
    </section>
    )
  }

  <!-- ───────────── About: sticky portrait on the left, the story scrolls on the right ───────────── -->
  <section class="intro" aria-labelledby="about">
    <figure class="intro__media">
      <Image
        src={portrait}
        alt="Viktoriia Sheveria in profile against a white chalk wall"
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 45vw, 100vw"
      />
    </figure>

    <div class="intro__content">
      <h2 class="intro__label label" id="about">About</h2>
      <p class="intro__lead reveal">{about.lead}</p>

      <dl class="facts reveal">
        {
          about.facts.map(({ value, label }) => (
            <div class="facts__item">
              <dt class="facts__value">{value}</dt>
              <dd class="facts__label label">{label}</dd>
            </div>
          ))
        }
      </dl>

      <ol class="numbered" role="list">
        {
          about.chapters.map(({ id, title, text }, i) => (
            <li class="numbered__item reveal" id={id}>
              <span class="numbered__index label">0{i + 1}</span>
              <div>
                <h3 class="numbered__title">{title}</h3>
                <p class="numbered__text">{text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────── How I work + toolkit ───────────── -->
  <section class="section" aria-labelledby="approach">
    <SectionHeading id="approach" index="01" title="How I work" />
    <div class="method">
      <ol class="numbered" role="list">
        {
          about.approach.map(({ step, text }, i) => (
            <li class="numbered__item reveal">
              <span class="numbered__index label">0{i + 1}</span>
              <p class="numbered__text"><strong>{step}.</strong> {text}</p>
            </li>
          ))
        }
      </ol>

      <div class="toolkit reveal" id="toolkit">
        <h3 class="label">Toolkit</h3>
        <dl class="skills">
          {
            about.skills.map(({ group, items }) => (
              <div class="skills__group">
                <dt class="label">{group}</dt>
                <dd>{items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- ───────────── Contact ───────────── -->
  <section class="section contact" aria-labelledby="contact">
    <SectionHeading id="contact" index="02" title="Contact" />
    <p class="contact__lead label">Open to front-end and WordPress roles in London or remote.</p>
    <a class="contact__email link-line" href={`mailto:${site.email}`}>{site.email}</a>
    <ul class="contact__links label" role="list">
      {
        socials.map(({ label, href }) => (
          <li>
            <a class="link-line" href={href} rel="me noopener" target="_blank">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <a class="to-top" href="#main" aria-label="Back to top">
    <svg viewBox="0 0 16 24" aria-hidden="true" focusable="false">
      <path d="M8 24 V1 M1 8 L8 1 L15 8" />
    </svg>
  </a>
</BaseLayout>

<script>
  import { assembleHero } from '@/scripts/assemble';
  import { initGallery } from '@/scripts/gallery';

  const hero = document.querySelector<HTMLElement>('.hero');
  const gallery = document.querySelector<HTMLElement>('.gallery');
  hero && assembleHero(hero);
  gallery && initGallery(gallery);
</script>

<style>
  /* ── Hero: a field of code that gathers into one function ── */
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    place-items: center;
    min-block-size: 100svh;
    padding: 6rem var(--gutter) var(--space-l); /* 6rem clears the fixed header */
    overflow: hidden;
  }

  .code-field {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    pointer-events: none;
    transition:
      filter 2.2s var(--ease-out),
      opacity 2.2s var(--ease-out);
  }

  /* The leftover code blurs and melts away like a veil (class set by assemble.ts) */
  .code-field:global(.is-melting) {
    filter: blur(10px);
    opacity: 0;
  }

  .hero__code {
    grid-row: 2;
    position: relative;
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 0.5rem + 1.15vw, 1.45rem);
    line-height: 1.75;
    white-space: pre;
    max-inline-size: 100%;
  }

  .hero__line {
    display: block;
  }

  [data-char] {
    display: inline-block; /* transforms need a box */
  }

  /* With JS the characters wait invisible until they fly in; without JS they simply show */
  :global(.js) .hero:not(:global(.is-assembling)) [data-char] {
    opacity: 0;
  }

  /* Quiet syntax colours: the name and the values carry the weight */
  .tok--keyword { color: rgb(53 53 53 / 0.45); }
  .tok--punct { color: rgb(53 53 53 / 0.4); }
  .tok--key { color: rgb(53 53 53 / 0.7); }
  .tok--string { color: var(--ink); }
  .tok--name { color: var(--ink); font-weight: 600; }

  .hero__scroll {
    grid-row: 3;
    align-self: end;
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-decoration: none;
  }

  .hero__arrow,
  .to-top svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hero__arrow {
    inline-size: 0.75rem;
    block-size: 2.5rem;
    transition: translate var(--duration) var(--ease-out);
  }

  .hero__scroll:hover .hero__arrow {
    translate: 0 0.4rem;
  }

  /* Appears once the function has come together */
  :global(.js) .hero__scroll {
    opacity: 0;
    transition: opacity 1s var(--ease-out);
  }

  :global(.js) .hero:global(.is-assembled) .hero__scroll {
    opacity: 1;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }

  /* ── Gallery: moved by gallery.ts with a transform ── */
  .gallery {
    overflow: hidden;
    padding-block: var(--space-l) var(--space-2xl);
    cursor: grab;
    touch-action: pan-y; /* vertical swipes still scroll the page */
    user-select: none;
  }

  .gallery:global(.is-dragging) {
    cursor: grabbing;
  }

  .gallery:focus-visible {
    outline-offset: -4px;
  }

  .gallery__track {
    display: flex;
    inline-size: max-content;
    will-change: transform;
  }

  .gallery__list {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    padding-inline-end: clamp(1rem, 3vw, 3rem);
  }

  .gallery__note {
    padding: var(--space-l) var(--gutter) 0;
    color: var(--ink-muted);
  }

  .gallery__item a {
    display: block;
    overflow: hidden;
  }

  /* Screenshots keep their own proportions — nothing is cropped or stretched */
  .gallery__item :global(img) {
    block-size: clamp(13rem, 24vw, 26rem);
    inline-size: auto;
    max-inline-size: none;
    transition: scale 1s var(--ease-out);
    -webkit-user-drag: none;
  }

  /* Every third one is taller, so the strip has rhythm */
  .gallery__item:nth-child(3n + 2) :global(img) {
    block-size: clamp(15rem, 29vw, 31rem);
  }

  .gallery__item a:hover :global(img) {
    scale: 1.03;
  }

  /* ── About: sticky portrait on the left, story scrolls on the right ── */
  .intro {
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--gutter) 0;
  }

  .intro__media {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  .intro__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .intro__label {
    padding-block-end: var(--space-m);
  }

  .intro__lead {
    max-inline-size: 18ch;
    padding-block-end: var(--space-l);
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  /* Three quick facts in a row */
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-m);
    margin: 0 0 var(--space-xl);
  }

  .facts__item {
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding-block-start: var(--space-s);
    box-shadow: var(--engrave-top);
  }

  .facts__value {
    font-size: var(--step-3);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .facts__label {
    margin: 0;
    color: var(--ink-muted);
  }

  @media (width >= 64rem) {
    .intro {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    /* The portrait stays put while the story scrolls past it */
    .intro__media {
      position: sticky;
      inset-block-start: 5rem;
      block-size: calc(100svh - 7rem);
      aspect-ratio: auto;
    }
  }

  /* ── Numbered rows (01, 02, 03) with engraved dividers ── */
  .numbered__item {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-l);
    box-shadow: var(--engrave-top);
  }

  .numbered__item:last-child {
    box-shadow: var(--engrave-top), var(--engrave-bottom);
  }

  .numbered__title {
    margin-block-end: var(--space-xs);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .numbered__text {
    max-inline-size: 30rem;
    font-size: var(--step-0);
    line-height: 1.65;
    letter-spacing: -0.01em;
  }

  @media (width >= 48rem) {
    .numbered__item {
      grid-template-columns: 5rem 1fr;
    }
  }

  /* ── Method + toolkit ── */
  .method {
    display: grid;
    gap: var(--space-xl) var(--space-l);
  }

  @media (width >= 64rem) {
    .method {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .toolkit h3 {
    padding-block-end: var(--space-m);
  }

  .skills__group {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-s);
    padding-block: var(--space-m);
    box-shadow: var(--engrave-top);
  }

  .skills__group:last-child {
    box-shadow: var(--engrave-top), var(--engrave-bottom);
  }

  .skills dt {
    color: var(--ink-muted);
  }

  /* ── Contact ── */
  .contact__lead {
    color: var(--ink-muted);
  }

  .contact__email {
    margin-block: var(--space-m);
    font-size: min(var(--step-3), 7vw);
    font-weight: 300;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .contact__links {
    display: flex;
    gap: var(--space-m);
  }

  /* ── Back to top ── */
  .to-top {
    position: fixed;
    inset-block-end: var(--space-m);
    inset-inline-end: var(--gutter);
    z-index: 40;
    display: grid;
    place-items: center;
    inline-size: 3.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper-raised);
    box-shadow: 0 0.25rem 1.5rem rgb(53 53 53 / 0.08);
    color: var(--ink);
  }

  .to-top svg {
    inline-size: 0.8rem;
    transition: translate var(--duration) var(--ease-out);
  }

  .to-top:hover svg {
    translate: 0 -0.25rem;
  }

  /* Appears only after the first screen — driven by scroll position, no JS */
  @supports (animation-timeline: scroll()) {
    /* Longhands on purpose — see .reveal in global.css */
    .to-top {
      animation-name: to-top-in;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll();
      animation-range: 0 60vh;
    }
  }

  @keyframes to-top-in {
    0%,
    80% {
      opacity: 0;
      visibility: hidden;
      scale: 0.8;
    }
  }
</style>
